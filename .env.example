# Supabase configuration. Copy this file to `.env` and fill in real values.
# All Supabase access happens in the main process (never the renderer), so these use the
# MAIN_VITE_ prefix electron-vite reserves for main-process-only env vars — this keeps them
# out of the renderer bundle entirely, unlike a plain VITE_ prefix which would also ship them
# to the renderer.
#
# Only the publishable/anonymous key belongs here. Never put the Supabase service-role key
# in this file or anywhere in the Electron app.
MAIN_VITE_SUPABASE_URL=
MAIN_VITE_SUPABASE_PUBLISHABLE_KEY=
